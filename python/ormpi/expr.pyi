from typing import Any, final

# ── F expression ─────────────────────────────────────────────────────────

class _FExpr:
    lhs: Any
    op: str
    rhs: Any
    def __add__(self, other: Any) -> _FExpr: ...
    def __sub__(self, other: Any) -> _FExpr: ...
    def __mul__(self, other: Any) -> _FExpr: ...
    def __repr__(self) -> str: ...

class F:
    """Reference to a model field for use in expressions and updates.

    Example::

        await Post.objects.filter(pk=1).update(views=F("views") + 1)
    """
    name: str

    def __init__(self, name: str) -> None: ...
    def __repr__(self) -> str: ...
    def __add__(self, other: Any) -> _FExpr: ...
    def __radd__(self, other: Any) -> _FExpr: ...
    def __sub__(self, other: Any) -> _FExpr: ...
    def __rsub__(self, other: Any) -> _FExpr: ...
    def __mul__(self, other: Any) -> _FExpr: ...
    def __rmul__(self, other: Any) -> _FExpr: ...
    def __truediv__(self, other: Any) -> _FExpr: ...
    def __mod__(self, other: Any) -> _FExpr: ...
    def __neg__(self) -> _FExpr: ...

# ── Q combinator ─────────────────────────────────────────────────────────

class Q:
    """Filter condition combinator supporting ``&``, ``|``, ``~``.

    Example::

        Q(name="Alice") | Q(name="Bob")
        ~Q(active=False)
    """
    def __init__(self, **kwargs: Any) -> None: ...
    def __and__(self, other: Q) -> Q: ...
    def __or__(self, other: Q) -> Q: ...
    def __invert__(self) -> Q: ...
    def __repr__(self) -> str: ...

# ── Aggregates ───────────────────────────────────────────────────────────

class Aggregate:
    def __init__(self, field: str, *, distinct: bool = False, filter: Q | None = None) -> None: ...

class Count(Aggregate): ...
class Sum(Aggregate): ...
class Avg(Aggregate): ...
class Max(Aggregate): ...
class Min(Aggregate): ...
