from __future__ import annotations

from typing import Any, Awaitable, Generic, TypeVar, overload
from collections.abc import AsyncIterator

M = TypeVar("M", bound="Model")
_Row = TypeVar("_Row")

# ---------------------------------------------------------------------------
# Aggregates
# ---------------------------------------------------------------------------

class Aggregate:
    def __init__(self, field: str, **kwargs: Any) -> None: ...

class Count(Aggregate): ...
class Sum(Aggregate): ...
class Avg(Aggregate): ...
class Max(Aggregate): ...
class Min(Aggregate): ...

# ---------------------------------------------------------------------------
# Q filter object
# ---------------------------------------------------------------------------

class Q:
    def __init__(self, **kwargs: Any) -> None: ...
    def __and__(self, other: Q) -> Q: ...
    def __or__(self, other: Q) -> Q: ...
    def __invert__(self) -> Q: ...

# ---------------------------------------------------------------------------
# Transaction
# ---------------------------------------------------------------------------

class Transaction:
    is_open: bool
    async def commit(self) -> None: ...
    async def rollback(self) -> None: ...
    async def execute_raw(
        self, sql: str, params: list[Any] | None = None
    ) -> list[Any]: ...

# ---------------------------------------------------------------------------
# QuerySet
# ---------------------------------------------------------------------------

class QuerySet(Generic[M]):
    def filter(self, *args: Q, **kwargs: Any) -> QuerySet[M]: ...
    def exclude(self, *args: Q, **kwargs: Any) -> QuerySet[M]: ...
    def all(self) -> QuerySet[M]: ...
    def none(self) -> QuerySet[M]: ...
    def order_by(self, *fields: str) -> QuerySet[M]: ...
    def reverse(self) -> QuerySet[M]: ...
    def distinct(self, *fields: str) -> QuerySet[M]: ...
    def select_related(self, *fields: str, depth: int | None = None) -> QuerySet[M]: ...
    def prefetch_related(self, *lookups: str) -> QuerySet[M]: ...
    def only(self, *fields: str) -> QuerySet[M]: ...
    def defer(self, *fields: str) -> QuerySet[M]: ...
    def using(self, alias: str) -> QuerySet[M]: ...
    def using_transaction(self, txn: Transaction) -> QuerySet[M]: ...
    def annotate(self, **kwargs: Any) -> QuerySet[M]: ...
    def values(self, *fields: str) -> QuerySet[Any]: ...
    def values_list(
        self, *fields: str, flat: bool = False
    ) -> QuerySet[Any]: ...
    def __aiter__(self) -> AsyncIterator[M]: ...
    def __await__(self) -> Any: ...
    @overload
    def __getitem__(self, key: int) -> Awaitable[M]: ...
    @overload
    def __getitem__(self, key: slice) -> QuerySet[M]: ...
    def get(self, *args: Q, **kwargs: Any) -> Awaitable[M]: ...
    def create(self, **kwargs: Any) -> Awaitable[M]: ...
    def get_or_create(
        self, defaults: dict[str, Any] | None = None, **kwargs: Any
    ) -> Awaitable[tuple[M, bool]]: ...
    def update_or_create(
        self, defaults: dict[str, Any] | None = None, **kwargs: Any
    ) -> Awaitable[tuple[M, bool]]: ...
    def update(self, **kwargs: Any) -> Awaitable[int]: ...
    def delete(self) -> Awaitable[tuple[int, dict[str, int]]]: ...
    def count(self) -> Awaitable[int]: ...
    def exists(self) -> Awaitable[bool]: ...
    def first(self) -> Awaitable[M | None]: ...
    def last(self) -> Awaitable[M | None]: ...
    def earliest(self, *fields: str) -> Awaitable[M]: ...
    def latest(self, *fields: str) -> Awaitable[M]: ...
    def aggregate(self, **kwargs: Any) -> Awaitable[dict[str, Any]]: ...
    def bulk_create(
        self,
        objs: list[M],
        batch_size: int | None = None,
        ignore_conflicts: bool = False,
    ) -> Awaitable[list[M]]: ...
    def bulk_update(
        self, objs: list[M], fields: list[str], batch_size: int | None = None
    ) -> Awaitable[int]: ...
    def raw(
        self, sql: str, params: list[Any] | None = None
    ) -> RawQuerySet[M]: ...
    def iterator(self, chunk_size: int = 2000) -> AsyncIterator[M]: ...

class RawQuerySet(Generic[M]):
    def __aiter__(self) -> AsyncIterator[M]: ...

# ---------------------------------------------------------------------------
# Manager
# ---------------------------------------------------------------------------

class Manager(Generic[M]):
    def all(self) -> QuerySet[M]: ...
    def filter(self, *args: Q, **kwargs: Any) -> QuerySet[M]: ...
    def exclude(self, *args: Q, **kwargs: Any) -> QuerySet[M]: ...
    def order_by(self, *fields: str) -> QuerySet[M]: ...
    def get(self, *args: Q, **kwargs: Any) -> Awaitable[M]: ...
    def create(self, **kwargs: Any) -> Awaitable[M]: ...
    def get_or_create(
        self, defaults: dict[str, Any] | None = None, **kwargs: Any
    ) -> Awaitable[tuple[M, bool]]: ...
    def update_or_create(
        self, defaults: dict[str, Any] | None = None, **kwargs: Any
    ) -> Awaitable[tuple[M, bool]]: ...
    def bulk_create(
        self,
        objs: list[M],
        batch_size: int | None = None,
        ignore_conflicts: bool = False,
    ) -> Awaitable[list[M]]: ...
    def count(self) -> Awaitable[int]: ...
    def exists(self) -> Awaitable[bool]: ...
    def first(self) -> Awaitable[M | None]: ...
    def last(self) -> Awaitable[M | None]: ...
    def using(self, alias: str) -> QuerySet[M]: ...
    def none(self) -> QuerySet[M]: ...
    def raw(
        self, sql: str, params: list[Any] | None = None
    ) -> RawQuerySet[M]: ...

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

class Model:
    id: Any
    pk: Any
    objects: Manager[Any]
    DoesNotExist: type[Exception]

    def __init__(self, **kwargs: Any) -> None: ...
    def __repr__(self) -> str: ...
    async def save(
        self, update_fields: list[str] | None = None, using: str = "default"
    ) -> None: ...
    async def delete(self, using: str = "default") -> None: ...
    async def refresh_from_db(
        self, fields: list[str] | None = None, using: str = "default"
    ) -> None: ...
    @classmethod
    def from_db(cls, db: str, field_names: list[str], values: list[Any]) -> Model: ...

# ---------------------------------------------------------------------------
# Connection proxy
# ---------------------------------------------------------------------------

class ConnectionProxy:
    def __getitem__(self, alias: str) -> Any: ...

# ---------------------------------------------------------------------------
# Top-level async functions
# ---------------------------------------------------------------------------

async def configure(databases: dict[str, Any]) -> None: ...
async def close() -> None: ...
async def begin(using: str = "default") -> Transaction: ...
async def execute_raw(
    sql: str, params: list[Any] | None = None, using: str = "default"
) -> list[Any]: ...
def get_version() -> str: ...

# ---------------------------------------------------------------------------
# DDL helpers
# ---------------------------------------------------------------------------

async def create_table(model_name: str, alias: str = "default") -> None: ...
async def create_all_tables(alias: str = "default") -> None: ...

# ---------------------------------------------------------------------------
# Transaction helpers (used by atomic context manager)
# ---------------------------------------------------------------------------

async def create_savepoint(txn: Transaction) -> str: ...
async def release_savepoint(txn: Transaction, name: str) -> None: ...
async def rollback_to_savepoint(txn: Transaction, name: str) -> None: ...

# ---------------------------------------------------------------------------
# Internal registration (used by Model metaclass)
# ---------------------------------------------------------------------------

def _register_model_class(cls: type) -> None: ...

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def run_cli(args: list[str]) -> int: ...

# ---------------------------------------------------------------------------
# Field types (exported from the Rust extension)
# ---------------------------------------------------------------------------

class Field:
    name: str
    attname: str
    null: bool
    blank: bool
    unique: bool
    primary_key: bool
    db_index: bool
    editable: bool
    help_text: str
    def contribute_to_class(self, cls: type, name: str) -> None: ...
    def __get__(self, obj: Any, objtype: type | None = None) -> Any: ...
    def __set__(self, obj: Any, value: Any) -> None: ...

class AutoField(Field):
    def __init__(self, *, primary_key: bool = True, **kwargs: Any) -> None: ...

class BigAutoField(Field):
    def __init__(self, *, primary_key: bool = True, **kwargs: Any) -> None: ...

class SmallAutoField(Field):
    def __init__(self, *, primary_key: bool = True, **kwargs: Any) -> None: ...

class IntegerField(Field):
    def __init__(
        self,
        *,
        null: bool = False,
        blank: bool = False,
        default: Any = ...,
        unique: bool = False,
        db_index: bool = False,
        primary_key: bool = False,
        db_column: str | None = None,
        help_text: str = "",
    ) -> None: ...

class BigIntegerField(Field):
    def __init__(self, *, null: bool = False, blank: bool = False, **kwargs: Any) -> None: ...

class SmallIntegerField(IntegerField): ...
class PositiveIntegerField(IntegerField): ...
class PositiveBigIntegerField(IntegerField): ...
class PositiveSmallIntegerField(IntegerField): ...

class FloatField(Field):
    def __init__(self, *, null: bool = False, blank: bool = False, **kwargs: Any) -> None: ...

class DecimalField(Field):
    max_digits: int
    decimal_places: int
    def __init__(
        self,
        max_digits: int,
        decimal_places: int,
        *,
        null: bool = False,
        blank: bool = False,
        **kwargs: Any,
    ) -> None: ...

class CharField(Field):
    max_length: int
    def __init__(
        self,
        max_length: int,
        *,
        null: bool = False,
        blank: bool = False,
        choices: list[tuple[Any, str]] | None = None,
        **kwargs: Any,
    ) -> None: ...

class TextField(Field):
    def __init__(self, *, null: bool = False, blank: bool = False, **kwargs: Any) -> None: ...

class SlugField(CharField): ...
class EmailField(CharField): ...
class URLField(CharField): ...
class IPAddressField(Field): ...
class GenericIPAddressField(Field): ...

class BooleanField(Field):
    def __init__(self, *, null: bool = False, default: bool | None = None, **kwargs: Any) -> None: ...

class DateField(Field):
    def __init__(
        self,
        *,
        auto_now: bool = False,
        auto_now_add: bool = False,
        null: bool = False,
        **kwargs: Any,
    ) -> None: ...

class TimeField(Field):
    def __init__(self, *, null: bool = False, **kwargs: Any) -> None: ...

class DateTimeField(Field):
    def __init__(
        self,
        *,
        auto_now: bool = False,
        auto_now_add: bool = False,
        null: bool = False,
        **kwargs: Any,
    ) -> None: ...

class DurationField(Field):
    def __init__(self, *, null: bool = False, **kwargs: Any) -> None: ...

class UUIDField(Field):
    def __init__(self, *, primary_key: bool = False, default: Any = ..., **kwargs: Any) -> None: ...

class JSONField(Field):
    def __init__(self, *, null: bool = False, default: Any = ..., **kwargs: Any) -> None: ...

class BinaryField(Field):
    def __init__(self, *, null: bool = False, **kwargs: Any) -> None: ...

CASCADE: str
PROTECT: str
SET_NULL: str
SET_DEFAULT: str
DO_NOTHING: str
RESTRICT: str

class ForeignKey(Field):
    def __init__(
        self,
        to: type | str,
        on_delete: str,
        *,
        related_name: str | None = None,
        to_field: str | None = None,
        db_constraint: bool = True,
        null: bool = False,
        blank: bool = False,
        db_index: bool = True,
        db_column: str | None = None,
    ) -> None: ...

class OneToOneField(ForeignKey): ...

class ManyToManyField(Field):
    def __init__(
        self,
        to: type | str,
        *,
        through: type | str | None = None,
        db_table: str | None = None,
        related_name: str | None = None,
        symmetrical: bool | None = None,
    ) -> None: ...
